#Get the read region infos
list_read_region <- list()
tsv_files <- list.files("/Users/azlannisar/Desktop/mount/Liqour_samples/Output/",
pattern = "^Read_Region_.*\\.tsv$",
full.names = TRUE)  #Das sind die 25 regionen die wir aus dem UXM atlas haben für
tsv_files
for (tsv in tsv_files) {
name <- basename(tsv)
file <- read.csv(tsv, sep= "\t")
file <- file[file$ref_position != -1, ]
file <- file[file$call_code == "m",]
if (nrow(file) == 0) {
cat(name, "contains no mapped reads - skipped.\n")
}else {
unique_entries <- length(unique(file$read_id))
cat(name, "contains", unique_entries, "unique reads. \n")
list_read_region[[name]] <- file
}
}
View(list_read_region)
View(list_read_region[["Read_Region_11466793_11467057.tsv"]])
