region = region_names,
unique_reads = sapply(list_read_region, function(df) n_distinct(df$read_id)),
unique_sites = sapply(list_read_region, function(df) nrow(df)),
average_me_score = sapply(list_read_region, function(df) mean(df$call_prob))
)
