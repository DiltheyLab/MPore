rule run_python_script:
    input:
        input_csv
    output:
        updated_csv
    params:
        skip_update=False,
        input_csv=input_csv,
        output_dir=output_dir
    log:
        "logs/run_python_script.log"
    shell:
        """
        set -o pipefail
        echo "[INFO] Starting run_python_script at $(date)" | tee -a {log}

        if [ "{params.skip_update}" = "True" ] && [ -e {output} ]; then
            echo "[INFO] Skipping update as {output} already exists. If u want to update remove the flag skip_update" | tee -a {log};
        else
            echo "[INFO] Running Update_Csv_file.py..." | tee -a {log}
            python Skripts/Update_input_csv.py {params.input_csv} {params.output_dir} 2>&1 | tee -a {log}
            echo "[INFO] Update_CSV_file.py sucessfully finished at $(date)" | tee -a {log}
        fi
        """
rule run_prokka_analysis:
    conda:
        "Environments/Prokka_env.yaml"
    input:
        input_csv
    output:
        directory(os.path.join(output_dir, "{file_name}"))
    params:
        output_dir=output_dir,
        Ref_path=lambda wildcards: data[data['File_name'] == wildcards.file_name].iloc[0]['Reference_path'],
        proteins_db="./REBASE_proteins_goldset.fasta"
    log:
        "logs/run_prokka_analysis_{file_name}.log"
    shell:
        """
        set -o pipefail
        echo "[INFO] Starting Prokka analysis at $(date)" | tee -a {log}
        prokka --outdir {output} --prefix {wildcards.file_name} --force --proteins {params.proteins_db} {params.Ref_path} 2>&1 | tee -a {log}
        echo "[INFO] Prokka analysis sucessfully finished at $(date)" | tee -a {log}
        """
rule run_blastp_analysis:
    conda:
        "Environments/Blastp_env.yaml"
    input:
        prokka_dir=os.path.join(output_dir, "{file_name}")
    output:
        os.path.join(output_dir, "{file_name}_blast_results.txt")
    params:
        BLAST_OUTDIR=output_dir
    log:
        "logs/run_blastp_analysis_{file_name}.log"
    shell:
        """
        set -o pipefail
        echo "[INFO] Starting blastp analysis at $(date)" | tee -a {log}
        blastp -query "{input.prokka_dir}/{wildcards.file_name}.faa" -db ./gold_standard_db -outfmt "6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore" -out {output} 2>&1 | tee -a {log}
        printf "Gene\tEnzyme\tpident\tlength\tmismatch\tgapopen\tqstart\tqend\tsstart\tsend\tevalue\tbitscore\n" | cat - {output} > temp && mv temp {output}
        echo "[INFO] blastp analysis sucessfully finished at $(date)" | tee -a {log}
        """
