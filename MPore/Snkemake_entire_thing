rule run_dorado:
    conda:
        "Environments/dorado_env.yaml"
    input:
        csv_file=updated_csv,
        dorado_path=Dorado_path
    output:
        bam=os.path.join(output_dir, "{file_name}.bam"),
        sorted_bam=os.path.join(output_dir, "{file_name}_sorted.bam"),
        bai=os.path.join(output_dir, "{file_name}_sorted.bam.bai")
    params:
        reference_path=lambda wildcards: data[data['File_name'] == wildcards.file_name].iloc[0]['Reference_path'],
        pod5_path=lambda wildcards: data[data['File_name'] == wildcards.file_name].iloc[0]['pod5_path'],
        skip_dorado=False
    log:
        "logs/run_dorado_{file_name}.log"
    resources:
        dorado=1
    shell:
        """
        set -o pipefail
        echo "[INFO] Starting dorado rule at $(date)" | tee -a {log} 
        if [ -e {output.bam} ] && [ -e {output.sorted_bam} ] && [ -e {output.bai} ]; then
            echo "Skipping {wildcards.file_name} since BAM file already exists." | tee -a {log};
        else
            echo "[INFO] Starting dorado run for {params.pod5_path} at $(date)" | tee -a {log}
            PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:50 {input.dorado_path}/bin/dorado basecaller \
            --modified-bases-models {input.dorado_path}/lib/dna_r10.4.1_e8.2_400bps_hac@v5.0.0_4mC_5mC@v1,{input.dorado_path}/lib/dna_r10.4.1_e8.2_400bps_hac@v5.0.0_6mA@v1 \
            {input.dorado_path}/lib/dna_r10.4.1_e8.2_400bps_hac@v5.0.0 \
            {params.pod5_path} \
            --reference {params.reference_path} > {output.bam} 2> >(tee -a {log} >&2)

            echo "[INFO] starting sorting process for {output.bam} at $(date)" | tee -a {log}
            samtools sort -o {output.sorted_bam} {output.bam} 2> >(tee -a {log} >&2)
            echo "[INFO] starting indexing process for {output.sorted_bam} at $(date)" | tee -a {log}
            samtools index {output.sorted_bam} 2> >(tee -a {log} >&2)
            echo "[INFO] dorado run for {params.pod5_path} successfully finished at $(date)" | tee -a {log}
        fi
        """
rule check_dorado_completion:
    input:
        bam_files
    output:
        flag=os.path.join(output_dir, "all_dorado_done.flag")
    log:
        "logs/check_dorado.log"
    shell:
        """
        set -o pipefail 
        all_files_exist=true
        for bam_file in {input}; do
            if [ ! -e $bam_file ]; then
                all_files_exist=false
                break
            fi
        done

        if [ "$all_files_exist" = true ]; then
            touch {output.flag}
        else
            echo "One or more BAM files are missing. Cannot mark Dorado as complete." | tee -a {log}
            exit 1
        fi
        """
rule run_modkit:
    conda:
        "Environments/Modkit_env.yaml"
    input:
        bam_files=rules.check_dorado_completion.output,
        csv_file=updated_csv
    output:
        os.path.join(output_dir, "{file_name}.bed")
    params:
        reference_path=lambda wildcards: data[data['File_name'] == wildcards.file_name].iloc[0]['Reference_path'],
        bam_path=lambda wildcards: pd.read_csv(updated_csv).loc[pd.read_csv(updated_csv)['File_name'] == wildcards.file_name, 'Bam_data'].iloc[0],
        skip_modkit=False
    log:
       "logs/run_modkit_{file_name}.log"
    shell:
        """
        set -o pipefail
        echo "[INFO] Starting the Modkit rule at $(date)" | tee -a {log}
        if [ "{params.skip_modkit}" = "True" ]; then
            echo "[INFO] Skipping {wildcards.file_name} due to skip_modkit flag." | tee -a {log}
            exit 0
        fi

        if [ -e {output[0]} ]; then
            echo "[INFO] Skipping {wildcards.file_name} since the BED file already exists." | tee -a {log}
        else
            echo "[INFO] starting Modkit process for {params.bam_path} at $(date)" | tee -a {log}
            modkit pileup {params.bam_path} {output[0]} --ref {params.reference_path} 2> >(tee -a {log} >&2)
            echo "[INFO] Modkit process for {output[0]} finished successfully at $(date)" | tee -a {log} 
        fi
        """
